# Nintendo fonts (users import their own; only the README ships)
/fonts/*
!/fonts/README.md
# build output, caches, saves and settings
build/
/cache/
save/
/larecomp.ini
# tools and Python environments (machine-specific)
tools/venv/
venv/
__pycache__/
.DS_Store
# visionOS: local signing, generated Xcode metadata and downloaded open font
/visionos/Local.xcconfig
/visionos/LASVision.xcodeproj/
/visionos/fonts/*.ttf
xcuserdata/
*.xcuserstate
